from {{ exceptions_module }} import ClientError, TransportError

type BinaryContent = bytes | Iterable[bytes] | AsyncIterable[bytes]


def binary_content(value: BinaryContent) -> bytes | AsyncIterable[bytes]:
    if isinstance(value, (bytes, AsyncIterable)):
        return value

    async def chunks() -> AsyncIterator[bytes]:
        for chunk in value:
            yield chunk

    return chunks()


class HttpResponse(Protocol):
    status_code: int
    headers: Mapping[str, str]

    @property
    def text(self) -> str: ...

    @property
    def content(self) -> bytes: ...

    def json(self) -> Any: ...

    def aiter_bytes(self, chunk_size: int | None = None) -> AsyncIterator[bytes]: ...

    async def aread(self) -> bytes: ...


{% if http_client == "protocol" %}
class AsyncResponseContextManager(Protocol):
    async def __aenter__(self) -> HttpResponse: ...

    async def __aexit__(self, *exc_info: object) -> object: ...


@runtime_checkable
class AsyncHttpClient(Protocol):
    async def request(self, method: str, url: str, **kwargs: Any) -> HttpResponse: ...

    def stream(
        self, method: str, url: str, **kwargs: Any
    ) -> AsyncResponseContextManager: ...

    async def aclose(self) -> None: ...
{% endif %}


@dataclass(frozen=True)
class UploadFile:
    content: bytes | BinaryIO
    filename: str | None = "upload"
    content_type: str | None = None
    headers: Mapping[str, str] | None = None


type UploadInput = UploadFile | bytes | BinaryIO
type FilePart = tuple[
    str | None,
    bytes | str | BinaryIO,
    str | None,
    Mapping[str, str],
]


def upload_file_part(value: UploadInput) -> FilePart:
    if isinstance(value, UploadFile):
        return value.filename, value.content, value.content_type, value.headers or {}
    name = getattr(value, "name", None)
    filename = (
        name.replace("\\", "/").rsplit("/", 1)[-1]
        if isinstance(name, str) else "upload"
    )
    return filename or "upload", value, None, {}


class BinaryStream:
    def __init__(self, response: HttpResponse, media_type: str | None) -> None:
        self._response = response
        self.media_type = media_type
        self.headers = response.headers
        self.content_length = _content_length(response.headers)
        self.filename = _filename(response.headers)

    async def iter_bytes(self, chunk_size: int | None = None) -> AsyncIterator[bytes]:
        try:
            async for chunk in self._response.aiter_bytes(chunk_size=chunk_size):
                yield chunk
        except ClientError:
            raise
        except Exception as error:
            raise TransportError(error) from error


def _header(headers: Mapping[str, str], name: str) -> str | None:
    value = headers.get(name)
    if value is not None:
        return value
    lower_name = name.lower()
    return next(
        (value for key, value in headers.items() if key.lower() == lower_name), None
    )


def _content_length(headers: Mapping[str, str]) -> int | None:
    value = _header(headers, "Content-Length")
    if value is None:
        return None
    try:
        return int(value)
    except ValueError:
        return None


def _filename(headers: Mapping[str, str]) -> str | None:
    value = _header(headers, "Content-Disposition")
    if value is None:
        return None
    message = Message()
    message["Content-Disposition"] = value
    return message.get_filename()
